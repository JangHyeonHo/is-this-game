<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML 주석 누락은 경고로만. 한국어 주석 사용. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    ⚠️ 이 프로젝트에는 게임 엔진 의존성을 추가하지 마세요.
    근거: docs/adr/0001-engine-agnostic-core.md
    Unity / Godot 타입을 참조하는 순간 이 프로젝트의 존재 이유가 사라집니다.
  -->

  <!--
    상태 변경 메서드는 internal로 막아 규칙 클래스(CareerSimulator 등)만 거치도록 합니다.
    테스트는 그 내부 규칙을 직접 검증해야 하므로 예외적으로 열어줍니다.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Guildwright.Core.Tests" />
  </ItemGroup>

</Project>
