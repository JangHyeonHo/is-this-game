<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Guildwright.Cli</RootNamespace>
    <AssemblyName>Guildwright.Console</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    이 프로젝트의 목적은 "재미있는가"를 판단하는 것입니다.
    그래픽 없이 텍스트로만, 실제 게임 흐름을 그대로 돌려봅니다.
    여기에 게임 규칙을 넣지 마세요 — 규칙은 전부 Guildwright.Core에 있습니다.
  -->
  <ItemGroup>
    <ProjectReference Include="../Guildwright.Core/Guildwright.Core.csproj" />
  </ItemGroup>

</Project>
